# Copy to .env next to your config. Process environment variables take precedence.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Override the bundled FFmpeg or configure the optional chat tool.
# FFMPEG=C:/path/to/ffmpeg.exe
# TWITCH_DOWNLOADER=TwitchDownloaderCLI

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram tokens are pasted at `gta-clips auth instagram --account <set>`, not kept here.
# INSTAGRAM_GRAPH_VERSION=v25.0  # optional

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
